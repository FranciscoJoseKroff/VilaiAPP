{
  "name": "aldea-backend",
  "version": "1.0.0",
  "description": "Backend (Node + Express + MongoDB) para Aldea Incremental",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:server": "node scripts/start-e2e-server.js",
    "test": "node test-logic.js && node test-tiempo.js && node test-escenarios.js && node test-estadisticas.js && node test-logros.js && node test-apodos.js && node test-antitrampas.js && node test-nuevos-contenidos.js && node test-ciclo-vida.js && node test-e2e.js && node test-seguridad.js",
    "generar-fixtures-aldeano": "node scripts/generar-fixtures-aldeano.js",
    "migrar-marca-demo": "node scripts/migrar-marca-demo.js",
    "migrar-estadisticas": "node scripts/migrar-estadisticas.js",
    "migrar-logros": "node scripts/migrar-logros.js",
    "migrar-perfil-ranking": "node scripts/migrar-perfil-ranking.js",
    "migrar-eventos-investigacion": "node scripts/migrar-eventos-investigacion.js",
    "migrar-ciclo-vida": "node scripts/migrar-ciclo-vida.js",
    "balance-nuevos-edificios": "node scripts/balance-nuevos-edificios.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4"
  }
}
