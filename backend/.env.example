# Copia este archivo a ".env" y completa tus valores reales.
# Local: mongodb://localhost:27017/aldea_incremental
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/aldea_incremental
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/aldea_incremental

# Genera uno largo y aleatorio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

PORT=4000
